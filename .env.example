# À copier dans .env. La clé reste uniquement sur le backend.
# Vide : conserver SQLite. Renseigné : utiliser PostgreSQL (jamais une variable VITE).
DATABASE_URL=
LOCAL_POSTGRES=false
# Pour une installation locale hors de l’emplacement Windows standard : PG_BIN=...
DB_POOL_SIZE=10
# Optionnel pour la migration : chemin de la base SQLite existante.
SQLITE_SOURCE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=200
